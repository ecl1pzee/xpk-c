[info]
homepage = "https://github.com/xorg62/tty-clock"
upstream = "xorg62"
name = "tty-clock"
version = "2.3"
desc = "A clock using lib ncurses"
license = "BSD-3-Clause"
deps = ["ncurses"]

[pkg]
